# AgriPredict AI Environment Configuration Example
# Copy this file to .env and replace placeholders with your actual credentials

# Flask Secret Key
FLASK_SECRET_KEY=agripredict_super_secret_session_key_2026

# Database Configuration (MySQL)
# Default format: mysql+pymysql://<username>:<password>@<host>:<port>/<database_name>
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=agripredict_db

# External Weather API (OpenWeatherMap)
# Get a free API key at: https://home.openweathermap.org/users/sign_up
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Satellite Data API (Copernicus / Sentinel Hub or Agromonitoring)
# Sign up at: https://www.sentinel-hub.com or https://agromonitoring.com
SENTINEL_CLIENT_ID=your_sentinel_client_id
SENTINEL_CLIENT_SECRET=your_sentinel_client_secret
AGROMONITORING_API_KEY=your_agromonitoring_key_here

# Operational Modes
# When set to True, realistic fallback simulation is provided if external APIs are not reachable
ENABLE_API_DEMO_FALLBACK=True
